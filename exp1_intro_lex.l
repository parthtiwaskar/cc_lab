/*
 * EXPERIMENT 1: Introduction to LEX tool, metadata, and patterns.
 * Course Outcome: CO1
 * 
 * DESCRIPTION:
 * Lex (Lexical Analyzer Generator) is a tool designed to generate programs 
 * that recognize lexical patterns in text. Flex is the modern Fast Lexical Analyzer.
 *
 * STRUCTURE OF A LEX FILE (.l):
 * -------------------------------------------------------------
 * 1. DEFINITIONS SECTION:
 *    %{
 *       // C code copied verbatim to the generated lex.yy.c (headers, prototypes, globals)
 *    %}
 *    // Regular definitions / alias macros, e.g. DIGIT [0-9]
 * -------------------------------------------------------------
 * 2. RULES SECTION:
 *    %%
 *    pattern { C action code }
 *    %%
 * -------------------------------------------------------------
 * 3. USER SUBROUTINES SECTION:
 *    // Auxiliary C functions, main(), yywrap()
 * -------------------------------------------------------------
 *
 * LEX PREDEFINED METADATA & VARIABLES:
 * - yytext   : (char*) String containing the matched lexeme.
 * - yyleng   : (int) Length of the matched lexeme in characters.
 * - yylineno : (int) Current input line number (requires %option yylineno).
 * - yyin     : (FILE*) Input stream pointer (defaults to stdin).
 * - yyout    : (FILE*) Output stream pointer (defaults to stdout).
 * - yylex()  : The primary scanning function generated by Lex.
 * - yywrap() : Function called on EOF. Returning 1 halts scanning.
 *
 * HOW TO COMPILE AND RUN:
 *   flex exp1_intro_lex.l
 *   gcc lex.yy.c -o exp1_intro_lex
 *   ./exp1_intro_lex
 */

%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int token_count = 0;
int line_count = 1;
%}

%option noyywrap
%option yylineno

/* Regular Definitions / Pattern Aliases */
DIGIT       [0-9]
LETTER      [a-zA-Z_]
ID          {LETTER}({LETTER}|{DIGIT})*
INT_NUM     {DIGIT}+
FLOAT_NUM   {DIGIT}+"."{DIGIT}+
KEYWORD     "int"|"float"|"char"|"double"|"void"|"if"|"else"|"while"|"for"|"return"
RELOP       "<="|">="|"=="|"!="|"<"|">"
ARITH_OP    "+"|"-"|"*"|"/"|"="
STRING_LIT  \"([^\\\"]|\\.)*\"
WS          [ \t]+

%%

\n              { line_count++; }
{WS}            { /* Ignore whitespace */ }

"//".*          { printf("[Line %d] SINGLE-LINE COMMENT : %s\n", line_count, yytext); }
"/*"([^*]|\*+[^*/])*\*+"/" { 
                    printf("[Line %d] MULTI-LINE COMMENT  : %s\n", line_count, yytext); 
                }

{KEYWORD}       { 
                    token_count++;
                    printf("[Line %d] KEYWORD      : '%s' (Length: %d)\n", line_count, yytext, (int)yyleng); 
                }

{RELOP}         { 
                    token_count++;
                    printf("[Line %d] RELATIONAL OP: '%s'\n", line_count, yytext); 
                }

{ARITH_OP}      { 
                    token_count++;
                    printf("[Line %d] ARITHMETIC OP : '%s'\n", line_count, yytext); 
                }

{FLOAT_NUM}     { 
                    token_count++;
                    printf("[Line %d] FLOAT NUMBER : '%s' (Value: %f)\n", line_count, yytext, atof(yytext)); 
                }

{INT_NUM}       { 
                    token_count++;
                    printf("[Line %d] INT NUMBER   : '%s' (Value: %d)\n", line_count, yytext, atoi(yytext)); 
                }

{STRING_LIT}    { 
                    token_count++;
                    printf("[Line %d] STRING LIT   : %s (Length: %d)\n", line_count, yytext, (int)yyleng); 
                }

{ID}            { 
                    token_count++;
                    printf("[Line %d] IDENTIFIER   : '%s' (Length: %d)\n", line_count, yytext, (int)yyleng); 
                }

[();{},]        { 
                    token_count++;
                    printf("[Line %d] DELIMITER    : '%s'\n", line_count, yytext); 
                }

.               { 
                    printf("[Line %d] UNKNOWN CHAR : '%s'\n", line_count, yytext); 
                }

%%

int main(int argc, char **argv) {
    printf("============================================================\n");
    printf("  EXPERIMENT 1: LEX Tool, Metadata, and Patterns Demo       \n");
    printf("============================================================\n");

    if (argc > 1) {
        FILE *fp = fopen(argv[1], "r");
        if (!fp) {
            perror("Error opening file");
            return 1;
        }
        yyin = fp;
        printf("Reading input from file: %s\n\n", argv[1]);
    } else {
        printf("Enter source code below (Press Ctrl+D to finish):\n\n");
    }

    yylex();

    printf("\n============================================================\n");
    printf("SCANNING COMPLETE SUMMARY:\n");
    printf("  Total Tokens Identified : %d\n", token_count);
    printf("  Total Lines Scanned     : %d\n", line_count);
    printf("============================================================\n");

    return 0;
}
